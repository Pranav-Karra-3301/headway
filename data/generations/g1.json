    },
    "rules": [
      {
        "id": "queue-relief-dispatch",
        "on": "bus_at_terminal",
        "priority": 20,
        "when": [
          {
            "f": "route_queue",
            "op": ">=",
            "v": 3
          }
        ],
        "do": {
          "type": "dispatch"
        },
        "say": "Queue relief: {route_queue} waiting, dispatching now"
      },
      {
        "id": "even-headway",
        "on": "bus_at_terminal",
        "priority": 10,
        "when": [
          {
            "f": "headway_ratio",
            "op": "<",
            "v": 1
          }
        ],
        "do": {
          "type": "hold",
          "until": "target_headway"
        },
        "say": "Waiting {seconds}s at the terminal to keep a {target_headway_s}s headway"
      }
    ],
    "defaults": {
      "bus_at_stop": {
        "type": "continue"
      },
      "bus_at_terminal": {
        "type": "dispatch"
      },
      "train_at_station": {
        "type": "setTrainDeparture",
        "dwellS": 45
      }
    }
  },
