      "emphasis": "allocation",
      "summary": "Add the supported terminal reassign-to-busiest rule (queue_ratio_other >= 6.67) and move one bus from the least-pressured route r1 to the most-pressured r3."
    },
    "params": {
      "allocation": {
        "r1": 1,
        "r2": 2,
        "r3": 3
      },
      "maxHoldS": 60,
      "trainDefaultDwellS": 45
    },
    "rules": [
      {
        "id": "reassign-to-busiest",
        "on": "bus_at_terminal",
        "priority": 30,
        "when": [
          {
            "f": "queue_ratio_other",
            "op": ">=",
            "v": 6.67
          }
        ],
        "do": {
          "type": "reassign",
          "to": "busiest"
        },
        "say": "Reassigning to busiest route: queue_ratio_other is {queue_ratio_other}"
      },
      {
        "id": "queue-relief-dispatch",
        "on": "bus_at_terminal",
        "priority": 20,
        "when": [
          {
            "f": "route_queue",
            "op": ">=",
            "v": 3
          }
        ],
        "do": {
          "type": "dispatch"
        },
        "say": "Queue relief: {route_queue} waiting, dispatching now"
      },
      {
        "id": "even-headway",
        "on": "bus_at_terminal",
        "priority": 10,
        "when": [
          {
            "f": "headway_ratio",
            "op": "<",
            "v": 1
          }
        ],
        "do": {
          "type": "hold",
          "until": "target_headway"
        },
        "say": "Waiting {seconds}s at the terminal to keep a {target_headway_s}s headway"
      }
    ],
    "defaults": {
      "bus_at_stop": {
        "type": "continue"
      },
      "bus_at_terminal": {
        "type": "dispatch"
      },
      "train_at_station": {
        "type": "setTrainDeparture",
        "dwellS": 45
      }
    }
  },
